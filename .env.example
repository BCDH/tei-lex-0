# Repo-local environment overrides for build tools.
# Values from .env and .env.local override inherited shell variables.

# Prefer an exact jar path for machine-specific Calabash installs:
# XMLCALABASH_JAR=/Users/your-user/.local/share/xmlcalabash/xmlcalabash-3.0.42/xmlcalabash-app-3.0.42.jar

# Or use a command on PATH:
# XMLCALABASH_CMD=xmlcalabash

# Optional Trang override for schema conversions:
# TRANG_JAR=/path/to/trang.jar
# TRANG_CMD=trang
